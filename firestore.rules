rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Patient User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId) && (isOwner(userId) || isValidUserProfile(request.resource.data));
      allow update: if isValidId(userId) && (isOwner(userId) || isValidUserProfile(request.resource.data));
      allow delete: if isOwner(userId);

      // Patient Medical Checkup Records
      match /records/{recordId} {
        allow get, list: if isOwner(userId) || isValidId(userId);
        allow create: if isValidId(recordId) && (isOwner(userId) || isSignedIn() || isValidId(userId));
        allow update: if isValidId(recordId) && (isOwner(userId) || isSignedIn() || isValidId(userId));
        allow delete: if isOwner(userId);
      }
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

