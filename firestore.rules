rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Patient User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId) && (isOwner(userId) || isValidUserProfile(request.resource.data));
      allow update: if isValidId(userId) && (isOwner(userId) || isValidUserProfile(request.resource.data));
      allow delete: if isOwner(userId);

      // Patient Medical Checkup Records
      match /records/{recordId} {
        allow get, list: if isOwner(userId) || isValidId(userId);
        allow create: if isValidId(recordId) && (isOwner(userId) || isSignedIn() || isValidId(userId));
        allow update: if isValidId(recordId) && (isOwner(userId) || isSignedIn() || isValidId(userId));
        allow delete: if isOwner(userId);
      }
    }

    // Physical Dispensing Commands for ESP32
    match /dispensing_commands/{commandId} {
      // Anyone with valid ID or auth can read commands (for real-time web UI listener & device polling)
      allow get, list: if true;
      
      // User creates a pending command with required fields
      allow create: if isValidId(commandId) &&
        request.resource.data.status in ['PENDING'] &&
        request.resource.data.requestedQuantity > 0;
        
      // Status update: from PENDING to PROCESSING, COMPLETED, FAILED, CANCELLED
      allow update: if isValidId(commandId) &&
        request.resource.data.status in ['PENDING', 'PROCESSING', 'COMPLETED', 'FAILED', 'CANCELLED', 'UNKNOWN'];
        
      allow delete: if false;
    }

    // Medicine Inventory
    match /inventory/{medicineId} {
      allow get, list: if true;
      allow create, update: if isValidId(medicineId);
      allow delete: if false;
    }

    // Device Registry & Heartbeats
    match /devices/{deviceId} {
      allow get, list: if true;
      allow create, update: if isValidId(deviceId);
      allow delete: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
