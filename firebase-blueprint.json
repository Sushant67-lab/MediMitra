{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with demographic and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "age": { "type": "number" },
        "ageCategory": { "type": "string", "enum": ["kid", "child", "adult", "senior"] },
        "sex": { "type": "string", "enum": ["female", "male", "other"] },
        "isPregnantOrNursing": { "type": "boolean" },
        "accountCreated": { "type": "boolean" },
        "authProvider": { "type": "string", "enum": ["email", "google"] },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "passwordSalt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Patient digital check-up assessment record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 100 },
        "patientEmail": { "type": "string", "maxLength": 150 },
        "primarySymptom": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "enum": ["mild", "moderate", "severe", "emergency"] },
        "clinicalSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "primarySymptom", "severity"]
    },
    "DispensingCommand": {
      "title": "DispensingCommand",
      "description": "Physical ESP32 servo medicine dispensing command transaction",
      "type": "object",
      "properties": {
        "commandId": { "type": "string", "maxLength": 128 },
        "medicineId": { "type": "string", "maxLength": 64 },
        "medicineName": { "type": "string", "maxLength": 120 },
        "requestedQuantity": { "type": "number" },
        "cycles": { "type": "number" },
        "deviceId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "status": { 
          "type": "string", 
          "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED", "CANCELLED", "UNKNOWN"] 
        },
        "executionResult": { "type": "string", "maxLength": 500 },
        "paymentTransactionId": { "type": "string", "maxLength": 128 },
        "paymentAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["VERIFIED", "HARDWARE_TEST"] },
        "servoConfig": {
          "type": "object",
          "properties": {
            "initialAngle": { "type": "number" },
            "dispenseAngle": { "type": "number" },
            "returnAngle": { "type": "number" },
            "holdTimeMs": { "type": "number" },
            "gpioPin": { "type": "number" }
          }
        },
        "createdAt": { "type": "string" },
        "claimedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["commandId", "medicineId", "medicineName", "requestedQuantity", "deviceId", "userId", "status", "paymentTransactionId", "paymentAmount", "paymentStatus", "createdAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Anti-fraud verified payment transaction authorizing a single medicine dispense",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "medicineId": { "type": "string", "maxLength": 64 },
        "medicineName": { "type": "string", "maxLength": 120 },
        "quantity": { "type": "number" },
        "unitPriceInr": { "type": "number" },
        "expectedAmountInr": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "paymentMethod": { "type": "string", "enum": ["UPI_QR", "RAZORPAY"] },
        "status": { "type": "string", "enum": ["CREATED", "PENDING_MERCHANT_VERIFICATION", "VERIFIED", "REJECTED", "EXPIRED"] },
        "utrNumber": { "type": "string", "minLength": 12, "maxLength": 12, "pattern": "^[0-9]{12}$" },
        "razorpayOrderId": { "type": "string", "maxLength": 80 },
        "razorpayPaymentId": { "type": "string", "maxLength": 80 },
        "verifiedByEmail": { "type": "string", "maxLength": 150 },
        "verificationNote": { "type": "string", "maxLength": 240 },
        "dispenseClaimed": { "type": "boolean" },
        "claimedCommandId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["transactionId", "medicineId", "medicineName", "quantity", "unitPriceInr", "expectedAmountInr", "userId", "userEmail", "paymentMethod", "status", "dispenseClaimed", "createdAt", "expiresAt", "updatedAt"]
    },
    "UtrClaim": {
      "title": "UtrClaim",
      "description": "Immutable unique 12-digit UPI UTR lock preventing duplicate or replayed UTR fraud",
      "type": "object",
      "properties": {
        "utrNumber": { "type": "string", "minLength": 12, "maxLength": 12, "pattern": "^[0-9]{12}$" },
        "transactionId": { "type": "string", "maxLength": 128 },
        "expectedAmountInr": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "claimedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["utrNumber", "transactionId", "expectedAmountInr", "userId", "claimedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized merchant/pharmacist UID permitted to verify payments",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["owner", "pharmacist"] }
      },
      "required": ["uid", "email", "role"]
    },
    "MedicineInventory": {
      "title": "MedicineInventory",
      "description": "Stock inventory levels for dispenser slots",
      "type": "object",
      "properties": {
        "medicineId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "availableQuantity": { "type": "number" },
        "reservedQuantity": { "type": "number" },
        "dispensedQuantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "slotNumber": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["medicineId", "name", "availableQuantity"]
    },
    "DeviceRegistry": {
      "title": "DeviceRegistry",
      "description": "Registered ESP32 hardware dispensing units",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 64 },
        "deviceName": { "type": "string", "maxLength": 100 },
        "deviceToken": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE"] },
        "lastHeartbeat": { "type": "string" },
        "ipAddress": { "type": "string" },
        "servoPin": { "type": "number" },
        "servoInitialAngle": { "type": "number" },
        "servoDispenseAngle": { "type": "number" },
        "servoHoldTimeMs": { "type": "number" }
      },
      "required": ["deviceId", "deviceName", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each authenticated patient"
    },
    "/users/{userId}/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Health checkup history and medical assessments for a patient"
    },
    "/payment_transactions/{transactionId}": {
      "schema": "PaymentTransaction",
      "description": "Payment verification records gating physical dispensing"
    },
    "/utr_claims/{utr}": {
      "schema": "UtrClaim",
      "description": "Single-use 12-digit UPI UTR claims preventing replay attacks"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized store owners/pharmacists allowed to verify UPI payments"
    },
    "/dispensing_commands/{commandId}": {
      "schema": "DispensingCommand",
      "description": "Command queue for physical ESP32 medicine dispatch"
    },
    "/inventory/{medicineId}": {
      "schema": "MedicineInventory",
      "description": "Real-time medicine inventory stock tracking"
    },
    "/devices/{deviceId}": {
      "schema": "DeviceRegistry",
      "description": "ESP32 dispenser unit metadata, heartbeat, and calibration"
    }
  }
}
