{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with demographic and contact details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "age": { "type": "number" },
        "ageCategory": { "type": "string", "enum": ["kid", "child", "adult", "senior"] },
        "sex": { "type": "string", "enum": ["female", "male", "other"] },
        "isPregnantOrNursing": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Patient digital check-up assessment record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 100 },
        "patientEmail": { "type": "string", "maxLength": 150 },
        "primarySymptom": { "type": "string", "maxLength": 64 },
        "severity": { "type": "string", "enum": ["mild", "moderate", "severe", "emergency"] },
        "clinicalSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "primarySymptom", "severity"]
    },
    "DispensingCommand": {
      "title": "DispensingCommand",
      "description": "Physical ESP32 servo medicine dispensing command transaction",
      "type": "object",
      "properties": {
        "commandId": { "type": "string", "maxLength": 128 },
        "medicineId": { "type": "string", "maxLength": 64 },
        "medicineName": { "type": "string", "maxLength": 100 },
        "requestedQuantity": { "type": "number" },
        "cycles": { "type": "number" },
        "deviceId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "status": { 
          "type": "string", 
          "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED", "CANCELLED", "UNKNOWN"] 
        },
        "executionResult": { "type": "string", "maxLength": 500 },
        "servoConfig": {
          "type": "object",
          "properties": {
            "initialAngle": { "type": "number" },
            "dispenseAngle": { "type": "number" },
            "returnAngle": { "type": "number" },
            "holdTimeMs": { "type": "number" },
            "gpioPin": { "type": "number" }
          }
        },
        "createdAt": { "type": "string" },
        "claimedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["commandId", "medicineId", "medicineName", "requestedQuantity", "deviceId", "userId", "status", "createdAt"]
    },
    "MedicineInventory": {
      "title": "MedicineInventory",
      "description": "Stock inventory levels for dispenser slots",
      "type": "object",
      "properties": {
        "medicineId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "availableQuantity": { "type": "number" },
        "reservedQuantity": { "type": "number" },
        "dispensedQuantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 20 },
        "slotNumber": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["medicineId", "name", "availableQuantity"]
    },
    "DeviceRegistry": {
      "title": "DeviceRegistry",
      "description": "Registered ESP32 hardware dispensing units",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 64 },
        "deviceName": { "type": "string", "maxLength": 100 },
        "deviceToken": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE"] },
        "lastHeartbeat": { "type": "string" },
        "ipAddress": { "type": "string" },
        "servoPin": { "type": "number" },
        "servoInitialAngle": { "type": "number" },
        "servoDispenseAngle": { "type": "number" },
        "servoHoldTimeMs": { "type": "number" }
      },
      "required": ["deviceId", "deviceName", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each authenticated patient"
    },
    "/users/{userId}/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Health checkup history and medical assessments for a patient"
    },
    "/dispensing_commands/{commandId}": {
      "schema": "DispensingCommand",
      "description": "Command queue for physical ESP32 medicine dispatch"
    },
    "/inventory/{medicineId}": {
      "schema": "MedicineInventory",
      "description": "Real-time medicine inventory stock tracking"
    },
    "/devices/{deviceId}": {
      "schema": "DeviceRegistry",
      "description": "ESP32 dispenser unit metadata, heartbeat, and calibration"
    }
  }
}
